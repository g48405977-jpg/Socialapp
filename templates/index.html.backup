<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SocialApp</title>
    <link rel="stylesheet" href="/static/style.css">
</head>

<body class="tiktok-page">

<header class="tt-top">
    <div class="tt-logo">SocialApp</div>
    <div class="tt-tabs">
        <span class="active">For You</span>
        <span>Following</span>
    </div>
</header>

<main class="tt-feed">

{% for post in posts %}

<section class="tt-post">

    {% if post["image"] %}
        <img
            src="/static/uploads/{{ post['image'] }}"
            class="tt-media"
            alt="Post"
        >
    {% else %}
        <div class="tt-text-post">
            <div>
                {{ post["content"] }}
            </div>
        </div>
    {% endif %}

    <div class="tt-overlay"></div>

    <div class="tt-info">

        <a href="/profile/{{ post['username'] }}" class="tt-username">
            @{{ post["username"] }}
        </a>

        {% if post["content"] %}
        <p>{{ post["content"] }}</p>
        {% endif %}

        <div class="tt-music">
            🎵 Original sound · {{ post["username"] }}
        </div>

    </div>

    <div class="tt-actions">

        <div class="tt-avatar">
            {{ post["username"][0].upper() }}
        </div>

        {% if username %}
        <form method="POST" action="/like/{{ post['id'] }}">
            <button class="tt-action">
                ❤️
                <small>{{ post["likes"] }}</small>
            </button>
        </form>
        {% else %}
        <div class="tt-action">
            ❤️
            <small>{{ post["likes"] }}</small>
        </div>
        {% endif %}

        <button
            class="tt-action"
            onclick="openComments({{ post['id'] }})"
        >
            💬
            <small>Comments</small>
        </button>

        <button
            class="tt-action"
            onclick="sharePost('{{ post['id'] }}')"
        >
            ↗️
            <small>Share</small>
        </button>

    </div>

</section>

{% endfor %}

</main>


<nav class="tt-bottom">

    <a href="/" class="active">
        <span>⌂</span>
        Home
    </a>

    <a href="/search">
        <span>🔍</span>
        Search
    </a>

    {% if username %}
    <a href="javascript:openCreate()" class="tt-create">
        +
    </a>
    {% else %}
    <a href="/login" class="tt-create">
        +
    </a>
    {% endif %}

    <a href="/inbox">
        <span>💬</span>
        Inbox
    </a>

    {% if username %}
    <a href="/profile">
        <span>👤</span>
        Profile
    </a>
    {% else %}
    <a href="/login">
        <span>👤</span>
        Login
    </a>
    {% endif %}

</nav>


{% if username %}

<div id="create-modal" class="modal">

    <div class="modal-content">

        <button class="close-modal" onclick="closeCreate()">×</button>

        <h2>Create Post</h2>

        <form method="POST" action="/post" enctype="multipart/form-data">

            <textarea
                name="content"
                placeholder="What's happening?"
                rows="5"
            ></textarea>

            <label class="photo-upload">
                📸 Add Photo
                <input
                    type="file"
                    name="photo"
                    accept="image/*"
                >
            </label>

            <button type="submit" class="post-button">
                Post
            </button>

        </form>

    </div>

</div>

{% endif %}


<script>

function openCreate() {
    const modal = document.getElementById("create-modal");
    if (modal) modal.style.display = "flex";
}

function closeCreate() {
    const modal = document.getElementById("create-modal");
    if (modal) modal.style.display = "none";
}

function sharePost(id) {

    const url = window.location.origin + "/?post=" + id;

    if (navigator.share) {
        navigator.share({
            title: "SocialApp",
            url: url
        });
    } else {
        navigator.clipboard.writeText(url);
        alert("Post link copied!");
    }
}

function openComments(id) {
    window.location.href = "/?post=" + id + "#comments";
}

</script>

</body>
</html>

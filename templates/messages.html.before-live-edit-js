<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Chat - {{ username }}</title>

    <link
        rel="stylesheet"
        href="/static/style.css"
    >

</head>

<body class="chat-page">

<header class="chat-header">

    <a href="/inbox" class="back-link">
        ←
    </a>

    <div class="chat-user">
        {% if profile_image %}
            <img
                src="/static/uploads/{{ profile_image }}"
                class="chat-avatar chat-avatar-image"
                alt="Profile"
            >
        {% else %}
            <div class="chat-avatar">
                {{ username[0].upper() }}
            </div>
        {% endif %}

        <div>
            <strong>{{ username }}</strong>
            <small id="online-status">
    {% if is_online %}
        🟢 Online
    {% elif last_seen %}
        ⚫ Last seen {{ last_seen }}
    {% else %}
        ⚫ Offline
    {% endif %}
</small>
        </div>
    </div>

</header>


<main class="chat-messages">

    {% for message in messages %}

        {% if message["sender"] == session["username"] %}

            <div class="message-row sent" data-message-id="{{ message["id"] }}">

                <div class="message-tools">
                    {% if message["sender"] == session["username"] %}
                        <button type="button"
                                onclick="editMessage('{{ message['id'] }}')">✏️</button>

                        <button type="button"
                                onclick="deleteMessage('{{ message['id'] }}')">🗑️</button>
                    {% endif %}
                </div>

                <div class="message-bubble">

                    {% if message["reply_to"] %}
                        {% for original in messages %}
                            {% if original["id"] == message["reply_to"] %}
                                <div class="reply-preview-message">
                                    <strong>{{ original["sender"] }}</strong>
                                    <div>
                                        {{ original["content"] or "📎 Media message" }}
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    {% endif %}


                    {% if message["image"] %}
                        <img
                            src="/static/uploads/{{ message['image'] }}"
                            class="chat-image"
                            alt="Photo"
                        >
                    {% endif %}

                    {% if message["content"] %}
                        <div>{{ message["content"] }}</div>
                    {% endif %}

                    {% if message["voice"] %}
                        <audio
                            controls
                            class="chat-voice"
                            preload="metadata"
                        >
                            <source
                                src="/static/uploads/{{ message['voice'] }}"
                                type="audio/webm"
                            >
                            Your browser does not support audio.
                        </audio>
                    {% endif %}

                    <div class="message-actions">

    <form method="POST"
          action="/messages/edit/{{ message['id'] }}"
          style="display:inline;">
        <input
            type="text"
            id="reply-to"
        name="reply_to"
        value=""
        type="hidden"
    >
    <input
        name="content"
            value="{{ message['content'] }}"
            placeholder="Edit message"
            required
        >
        <button type="submit">✏️ Edit</button>
    </form>

    <form method="POST"
          action="/messages/delete/{{ message['id'] }}"
          style="display:inline;"
          onsubmit="return confirm('Delete this message?');">
        <button type="submit">🗑️ Delete</button>
    </form>

</div>

                    <button
    type="button"
    class="reply-button"
    onclick="startReply('{{ message['id'] }}', '{{ message['content']|e }}')"
>↩️ Reply</button>

                    <div class="message-reactions"
     data-message-id="{{ message["id"] }}">

    <form method="POST"
          action="/messages/react/{{ message["id"] }}"
          style="display:inline;">
        <button type="submit" name="reaction" value="❤️">❤️</button>
    </form>

    <form method="POST"
          action="/messages/react/{{ message["id"] }}"
          style="display:inline;">
        <button type="submit" name="reaction" value="👍">👍</button>
    </form>

    <form method="POST"
          action="/messages/react/{{ message["id"] }}"
          style="display:inline;">
        <button type="submit" name="reaction" value="😂">😂</button>
    </form>

    <form method="POST"
          action="/messages/react/{{ message["id"] }}"
          style="display:inline;">
        <button type="submit" name="reaction" value="😮">😮</button>
    </form>

    <form method="POST"
          action="/messages/react/{{ message["id"] }}"
          style="display:inline;">
        <button type="submit" name="reaction" value="😢">😢</button>
    </form>

    <form method="POST"
          action="/messages/react/{{ message["id"] }}"
          style="display:inline;">
        <button type="submit" name="reaction" value="😡">😡</button>
    </form>

    <div class="message-reaction"
         data-reaction-message-id="{{ message['id'] }}">
        {% set ns = namespace(counts={}) %}

        {% for reaction in reactions %}
            {% if reaction["message_id"] == message["id"] %}
                {% set current = ns.counts.get(reaction["reaction"], 0) %}
                {% set _ = ns.counts.update({
                    reaction["reaction"]: current + 1
                }) %}
            {% endif %}
        {% endfor %}

        {% for emoji, count in ns.counts.items() %}
            <span class="reaction-item">
                {{ emoji }} {{ count }}
            </span>
        {% endfor %}
    </div>

</div>


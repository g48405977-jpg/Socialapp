<script>
function formatLastSeen(value) {
    if (!value) return "⚫ Offline";

    const date = new Date(value.replace(" ", "T") + "Z");
    const now = new Date();

    const seconds = Math.floor((now - date) / 1000);

    if (seconds < 60) {
        return "⚫ Last seen just now";
    }

    const minutes = Math.floor(seconds / 60);

    if (minutes < 60) {
        return "⚫ Last seen " + minutes +
               (minutes === 1 ? " minute ago" : " minutes ago");
    }

    const hours = Math.floor(minutes / 60);

    if (hours < 24) {
        return "⚫ Last seen " + hours +
               (hours === 1 ? " hour ago" : " hours ago");
    }

    const days = Math.floor(hours / 24);

    if (days === 1) {
        return "⚫ Last seen yesterday";
    }

    return "⚫ Last seen " + days + " days ago";
}

const initialStatus =
    document.getElementById("online-status");

if (initialStatus &&
    initialStatus.textContent.includes("Last seen")) {

    initialStatus.textContent =
        formatLastSeen("{{ last_seen or '' }}");
}


socket.on("user_status", function(data) {

    if (data.username !== "{{ username }}") {
        return;
    }

    const status =
        document.getElementById("online-status");

    if (!status) return;

    if (data.is_online) {

        status.textContent = "🟢 Online";

    } else {

        status.textContent =
            formatLastSeen(data.last_seen);
    }
});
</script>


<script>
function startReply(messageId, content) {
    const input = document.getElementById("reply-to");
    const preview = document.getElementById("reply-preview");
    const text = document.getElementById("reply-text");

    if (!input || !preview || !text) return;

    input.value = messageId;
    text.textContent = "Replying to: " + (content || "message");
    preview.style.display = "flex";
}

function cancelReply() {
    const input = document.getElementById("reply-to");
    const preview = document.getElementById("reply-preview");

    if (input) input.value = "";
    if (preview) preview.style.display = "none";
}
</script>


<script>
async function editMessage(messageId) {
    const newText = prompt("Edit message:");

    if (newText === null || !newText.trim()) {
        return;
    }

    try {
        const response = await fetch(
            "/messages/edit/" + messageId,
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: "content=" + encodeURIComponent(newText.trim()),
                credentials: "same-origin"
            }
        );

        if (!response.ok) {
            alert("Edit failed");
            return;
        }

        location.reload();

    } catch (error) {
        console.error("Edit error:", error);
        alert("Edit failed");
    }
}

async function deleteMessage(messageId) {
    if (!confirm("Delete this message?")) {
        return;
    }

    try {
        const response = await fetch(
            "/messages/delete/" + messageId,
            {
                method: "POST",
                credentials: "same-origin"
            }
        );

        if (!response.ok) {
            alert("Delete failed");
            return;
        }

        location.reload();

    } catch (error) {
        console.error("Delete error:", error);
        alert("Delete failed");
    }
}
</script>

</body><script>
const input = document.getElementById("message-input");
const status = document.getElementById("typing-status");

let timer;

const socket = io();
let timer;

input.addEventListener("input", function () {

    socket.emit("typing", {
        username: "{{ session['username'] }}",
        receiver: "{{ username }}"
    });

    if (input.value.trim() !== "") {
        status.textContent = "Typing...";
    } else {
        status.textContent = "";
    }

    clearTimeout(timer);

    timer = setTimeout(() => {
        status.textContent = "";
    }, 1200);
});

socket.emit("message_seen", {
    sender: "{{ username }}",
    receiver: "{{ session['username'] }}"
});

socket.on("messages_seen", function (data) {
    if (data.sender === "{{ session['username'] }}" &&
        data.receiver === "{{ username }}") {

        document.querySelectorAll(".message-status").forEach(function(status) {
            status.textContent = "✓✓";
        });
    }
});

socket.on("new_message", function (data) {

    if (data.sender === "{{ username }}" &&
        data.receiver === "{{ session['username'] }}") {

        const row = document.createElement("div");
        row.className = "message-row received";

        const bubble = document.createElement("div");
        bubble.className = "message-bubble";

        if (data.image) {
            const img = document.createElement("img");

            img.src = "/static/uploads/" + data.image;
            img.className = "chat-image";
            img.alt = "Photo";

            bubble.appendChild(img);
        }

        if (data.voice) {
            const audio = document.createElement("audio");

            audio.controls = true;
            audio.preload = "metadata";
            audio.className = "chat-voice";

            const source = document.createElement("source");
            source.src = "/static/uploads/" + data.voice;
            source.type = "audio/webm";

            audio.appendChild(source);
            bubble.appendChild(audio);
        }

        if (data.content) {
            const text = document.createElement("div");
            text.textContent = data.content;
            bubble.appendChild(text);
        }

        row.appendChild(bubble);

        document.querySelector(".chat-messages").appendChild(row);

        window.scrollTo({
            top: document.body.scrollHeight,
            behavior: "smooth"
        });
    }
});


socket.on("user_typing", function (data) {

    if (data.username === "{{ username }}") {
        status.textContent = "Typing...";

        clearTimeout(timer);

        timer = setTimeout(() => {
            status.textContent = "";
        }, 1200);
    }
});
</script>





<script>
document.addEventListener("click", async function(event) {

    const button = event.target.closest(".reaction-button");

    if (!button) return;

    event.preventDefault();
    event.stopPropagation();

    const messageId = button.dataset.messageId;
    const reaction = button.dataset.reaction;

    if (!messageId || !reaction) return;

    console.log("REACTION CLICK:", messageId, reaction);

    try {
        const response = await fetch(
            "/messages/react/" + messageId,
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: "reaction=" + encodeURIComponent(reaction),
                credentials: "same-origin"
            }
        );

        console.log("REACTION RESPONSE:", response.status);

        if (!response.ok) {
            console.error("Reaction failed:", response.status);
        }

    } catch (error) {
        console.error("Reaction error:", error);
    }
});
</script>


<script>
socket.on("message_reaction", function(data) {

    console.log("LIVE REACTION:", data);

    const box = document.querySelector(
        '[data-reaction-message-id="' + data.message_id + '"]'
    );

    if (!box) {
        console.log("REACTION BOX NOT FOUND:", data.message_id);
        return;
    }

    box.innerHTML = "";

    if (data.counts) {
        Object.entries(data.counts).forEach(function(entry) {

            const span = document.createElement("span");

            span.className = "reaction-item";
            span.textContent = entry[0] + " " + entry[1];

            box.appendChild(span);
        });
    }
});
</script>


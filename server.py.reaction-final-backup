connected_users = {}

@socketio.on("connect")
def handle_connect():
    username = session.get("username")

    if username:
        connected_users[username] = request.sid

        conn = db()
        conn.execute(
            """
            UPDATE users
            SET is_online = 1
            WHERE username = ?
            """,
            (username,)
        )
        conn.commit()
        conn.close()

        socketio.emit(
            "user_status",
            {
                "username": username,
                "is_online": True,
                "last_seen": None
            }
        )


@socketio.on("disconnect")
def handle_disconnect():
    username = session.get("username")

    if username and connected_users.get(username) == request.sid:

        connected_users.pop(username, None)

        conn = db()
        conn.execute(
            """
            UPDATE users
            SET is_online = 0,
                last_seen = CURRENT_TIMESTAMP
            WHERE username = ?
            """,
            (username,)
        )
        conn.commit()

        last_seen = conn.execute(
            """
            SELECT last_seen
            FROM users
            WHERE username = ?
            """,
            (username,)
        ).fetchone()["last_seen"]

        conn.close()

        socketio.emit(
            "user_status",
            {
                "username": username,
                "is_online": False,
                "last_seen": last_seen
            }
        )


@socketio.on("typing")
def handle_typing(data):
    sender = data.get("username")
    receiver = data.get("receiver")

    if not sender or not receiver:
        return

    receiver_sid = connected_users.get(receiver)

    if receiver_sid:
        socketio.emit(
            "user_typing",
            data,
            to=receiver_sid
        )


@socketio.on("message_seen")
def handle_message_seen(data):
    sender = data.get("sender")
    receiver = data.get("receiver")

    if not sender or not receiver:
        return

    conn = db()
    conn.execute(
        """
        UPDATE messages
        SET read = 1
        WHERE sender = ?
        AND receiver = ?
        AND read = 0
        """,
        (sender, receiver)
    )
    conn.commit()
    conn.close()

    sender_sid = connected_users.get(sender)

    if sender_sid:
        socketio.emit(
            "messages_seen",
            {
                "sender": sender,
                "receiver": receiver
            },
            to=sender_sid
        )



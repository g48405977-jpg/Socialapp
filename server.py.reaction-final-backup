@app.route("/messages/<username>")
def messages(username):

    if "username" not in session:
        return redirect("/login")

    me = session["username"]

    conn = db()

    other = conn.execute(
        "SELECT username, profile_image, is_online, last_seen FROM users WHERE username = ?",
        (username,)
    ).fetchone()

    if not other:
        conn.close()
        return "User not found."

    conn.execute(
        """
        UPDATE messages
        SET read = 1
        WHERE sender = ?
        AND receiver = ?
        AND read = 0
        """,
        (username, me)
    )

    conn.commit()

    messages = conn.execute(
        """
        SELECT *
        FROM messages
        WHERE
        (sender = ? AND receiver = ?)
        OR
        (sender = ? AND receiver = ?)
        ORDER BY id ASC
        """,
        (me, username, username, me)
    ).fetchall()

    reactions = conn.execute("""
        SELECT message_id, username, reaction
        FROM message_reactions
        WHERE message_id IN (
            SELECT id
            FROM messages
            WHERE
                (sender = ? AND receiver = ?)
                OR
                (sender = ? AND receiver = ?)
        )
        ORDER BY id ASC
    """, (me, username, username, me)).fetchall()

    conn.close()

    return render_template(
        "messages.html",
        username=username,
        profile_image=other["profile_image"],
        is_online=other["is_online"],
        last_seen=other["last_seen"],
        messages=messages,
        reactions=reactions
    )


@app.route("/messages/<username>/send", methods=["POST"])
def send_message(username):

    if "username" not in session:
        return redirect("/login")

    import os
    import time
    from werkzeug.utils import secure_filename

    content = request.form.get("content", "").strip()

    image = request.files.get("image")
    voice = request.files.get("voice")

    image_path = None
    voice_path = None

    upload_dir = os.path.join(
        app.root_path,
        "static",
        "uploads",
        "chat"
    )

    os.makedirs(upload_dir, exist_ok=True)

    if image and image.filename:
        filename = secure_filename(image.filename)
        filename = str(int(time.time() * 1000)) + "_" + filename

        image.save(
            os.path.join(upload_dir, filename)
        )

        image_path = "chat/" + filename

    if voice and voice.filename:
        filename = secure_filename(voice.filename)

        if not filename:
            filename = "voice.webm"

        filename = str(int(time.time() * 1000)) + "_" + filename

        voice.save(
            os.path.join(upload_dir, filename)
        )

        voice_path = "chat/" + filename

    if content or image_path or voice_path:

        conn = db()

        cursor = conn.execute(
            """
            INSERT INTO messages
            (sender, receiver, content, image, voice)
            VALUES (?, ?, ?, ?, ?)
            """,
            (
                session["username"],
                username,
                content,
                image_path,
                voice_path
            )
        )

        message_id = cursor.lastrowid

        socketio.emit(
            "new_message",
            {
                "id": message_id,
                "sender": session["username"],
                "receiver": username,
                "content": content,
                "image": image_path,
                "voice": voice_path
            },
            to=connected_users.get(username)
        )

        conn.execute(
            """
            INSERT INTO notifications
            (username, sender, type, message)
            VALUES (?, ?, ?, ?)
            """,
            (
                username,
                session["username"],
                "message",
                session["username"] + " sent you a message"
            )
        )

        conn.commit()
        conn.close()

    return redirect("/messages/" + username)



@app.route("/inbox")
def inbox():

    if "username" not in session:
        return redirect("/login")

    me = session["username"]

    conn = db()

    rows = conn.execute(
        """
        SELECT *
        FROM messages
        WHERE sender = ? OR receiver = ?
        ORDER BY id DESC
        """,
        (me, me)
    ).fetchall()

    conversations = []
    seen = set()

    for row in rows:

        if row["sender"] == me:
            person = row["receiver"]
        else:
            person = row["sender"]

        if person in seen:
            continue

        seen.add(person)

        user = conn.execute(
            """
            SELECT username, profile_image
            FROM users
            WHERE username = ?
            """,
            (person,)
        ).fetchone()

        unread = conn.execute(
            """
            SELECT COUNT(*)
            FROM messages
            WHERE sender = ?
            AND receiver = ?
            AND read = 0
            """,
            (person, me)
        ).fetchone()[0]

        conversations.append({
            "username": person,
            "last_message": row["content"],
            "created_at": row["created_at"],
            "profile_image": user["profile_image"] if user else None,
            "unread": unread
        })

    conn.close()

    return render_template(
        "inbox.html",
        conversations=conversations
    )



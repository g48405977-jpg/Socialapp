def react_message(message_id):

    if "username" not in session:
        return redirect("/login")

    me = session["username"]
    reaction = request.form.get("reaction", "").strip()

    allowed = ["❤️", "😂", "👍", "😢", "😡"]

    if reaction not in allowed:
        return redirect("/")

    conn = db()

    message = conn.execute("""
        SELECT id, sender, receiver
        FROM messages
        WHERE id = ?
    """, (message_id,)).fetchone()

    if not message:
        conn.close()
        return redirect("/")

    if me not in (message["sender"], message["receiver"]):
        conn.close()
        return redirect("/")

    conn.execute("""
        INSERT INTO message_reactions
        (message_id, username, reaction)
        VALUES (?, ?, ?)
        ON CONFLICT(message_id, username)
        DO UPDATE SET reaction = excluded.reaction
    """, (message_id, me, reaction))

    conn.commit()

    reactions = conn.execute("""
        SELECT username, reaction
        FROM message_reactions
        WHERE message_id = ?
    """, (message_id,)).fetchall()

    reaction_counts = {}

    for row in reactions:
        reaction_counts[row["reaction"]] = (
            reaction_counts.get(row["reaction"], 0) + 1
        )

    conn.close()

    receiver = (
        message["receiver"]
        if me == message["sender"]
        else message["sender"]
    )

    reaction_data = {
        "message_id": message_id,
        "username": me,
        "reaction": reaction,
        "counts": reaction_counts
    }

    # Send reaction update to the other user
    other_sid = connected_users.get(receiver)

    if other_sid:
        socketio.emit(
            "message_reaction",
            reaction_data,
            to=other_sid
        )

    # Also send it back to the current user
    my_sid = connected_users.get(me)

    if my_sid:
        socketio.emit(
            "message_reaction",
            reaction_data,
            to=my_sid
        )

    return {
        "success": True,
        "message_id": message_id,
        "reaction": reaction,
        "counts": reaction_counts
    }


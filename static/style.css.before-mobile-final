* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background: #f2f4f7;
    color: #222;
    padding-bottom: 70px;
}

header {
    background: #1877f2;
    color: white;
    padding: 15px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 10;
}

header h2 {
    font-size: 22px;
}

header button {
    background: white;
    color: #1877f2;
    border: none;
    padding: 9px 15px;
    border-radius: 20px;
    font-weight: bold;
}

nav {
    background: white;
    display: flex;
    justify-content: space-around;
    padding: 12px 5px;
    border-bottom: 1px solid #ddd;
}

nav button {
    border: none;
    background: none;
    font-size: 14px;
    padding: 8px;
}

main {
    max-width: 600px;
    margin: 15px auto;
    padding: 0 10px;
}

.create {
    background: white;
    padding: 15px;
    border-radius: 12px;
    margin-bottom: 15px;
    display: flex;
    gap: 8px;
}

.create input {
    flex: 1;
    border: 1px solid #ddd;
    border-radius: 20px;
    padding: 12px;
    outline: none;
}

.create button {
    background: #1877f2;
    color: white;
    border: none;
    border-radius: 20px;
    padding: 10px 16px;
}

.post {
    background: white;
    padding: 15px;
    margin-bottom: 15px;
    border-radius: 12px;
    box-shadow: 0 1px 3px #ddd;
}

.user {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
}

.avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #1877f2;
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: bold;
}

.post p {
    margin-bottom: 15px;
    font-size: 16px;
}

.actions {
    border-top: 1px solid #eee;
    padding-top: 10px;
    display: flex;
    justify-content: space-around;
}

.actions button {
    border: none;
    background: none;
    padding: 8px;
    font-size: 14px;
}

.post-image {
    width: 100%;
    max-height: 600px;
    object-fit: cover;
    border-radius: 12px;
    margin-top: 10px;
}

.create input[type="file"] {
    margin: 10px 0;
    padding: 8px;
}


.profile-image {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    margin: 0 auto 15px;
}

.profile-upload {
    margin-top: 20px;
}


.stats {
    display: flex;
    justify-content: center;
    gap: 35px;
    margin: 20px 0;
}

.stats div {
    display: flex;
    flex-direction: column;
    text-align: center;
}

.stats strong {
    font-size: 20px;
}

.stats span {
    font-size: 13px;
    color: #777;
}


.user-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px;
    margin: 10px 0;
    border-radius: 12px;
    background: white;
}

.user-card form {
    margin-left: auto;
}

.profile-small {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    object-fit: cover;
}


.notification {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 15px;
    margin: 10px 0;
    border-radius: 12px;
    background: white;
    box-shadow: 0 1px 5px rgba(0,0,0,0.08);
}

.notification small {
    margin-left: auto;
    color: #777;
}

.empty {
    text-align: center;
    padding: 40px 10px;
}


.badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    margin-left: 4px;
    border-radius: 10px;
    background: red;
    color: white;
    font-size: 12px;
    font-weight: bold;
}


.chat-box {
    min-height: 300px;
    padding: 15px;
    margin: 15px 0;
    border-radius: 15px;
    background: #f5f5f5;
    overflow-y: auto;
}

.message {
    display: flex;
    margin: 10px 0;
}

.message span {
    padding: 10px 14px;
    border-radius: 16px;
    max-width: 75%;
    word-wrap: break-word;
}

.mine {
    justify-content: flex-end;
}

.mine span {
    background: #1877f2;
    color: white;
}

.theirs {
    justify-content: flex-start;
}

.theirs span {
    background: white;
}

.message-form {
    display: flex;
    gap: 8px;
}

.message-form input {
    flex: 1;
}


.message-button {
    display: inline-block;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    background: #1877f2;
    color: white;
}


.chat-user {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px;
    margin: 8px 0;
    border-radius: 12px;
    background: white;
    text-decoration: none;
    color: inherit;
}

.chat-user p {
    margin: 4px 0 0;
    color: #777;
    font-size: 13px;
}


nav {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    padding: 12px;
    justify-content: center;
}

nav a {
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 10px;
    background: white;
}


.username-link {
    text-decoration: none;
    color: inherit;
}

.username-link:hover {
    text-decoration: underline;
}



* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html,
body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Arial, sans-serif;
    background: #000;
    color: #fff;
}

/* TOP */

.tt-top {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 58px;
    z-index: 1000;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 25px;

    background: linear-gradient(
        to bottom,
        rgba(0,0,0,.65),
        transparent
    );
}

.tt-logo {
    position: absolute;
    left: 15px;
    font-size: 20px;
    font-weight: 800;
}

.tt-tabs {
    display: flex;
    gap: 22px;
    font-size: 15px;
    font-weight: 600;
}

.tt-tabs span {
    opacity: .65;
}

.tt-tabs .active {
    opacity: 1;
    border-bottom: 2px solid #fff;
    padding-bottom: 5px;
}

/* FEED */

.tt-feed {
    width: 100%;
    height: 100vh;
    overflow-y: scroll;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
}

.tt-feed::-webkit-scrollbar {
    display: none;
}

/* POST */

.tt-post {
    position: relative;
    width: 100%;
    height: 100vh;
    scroll-snap-align: start;
    overflow: hidden;
    background: #111;
}

/* IMAGE */

.tt-media {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
}

/* TEXT POST */

.tt-text-post {
    width: 100%;
    height: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 40px;

    background:
        radial-gradient(
            circle at center,
            #444,
            #111 70%
        );

    text-align: center;
}

.tt-text-post div {
    max-width: 90%;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.3;
}

/* DARK OVERLAY */

.tt-overlay {
    position: absolute;
    inset: 0;

    background: linear-gradient(
        to top,
        rgba(0,0,0,.8),
        transparent 45%,
        rgba(0,0,0,.15)
    );
}

/* POST INFO */

.tt-info {
    position: absolute;
    left: 15px;
    right: 80px;
    bottom: 90px;
    z-index: 5;
}

.tt-username {
    color: white;
    text-decoration: none;
    font-size: 18px;
    font-weight: 800;
}

.tt-info p {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.4;
}

.tt-music {
    margin-top: 12px;
    font-size: 13px;
    opacity: .9;
}

/* ACTIONS */

.tt-actions {
    position: absolute;
    right: 10px;
    bottom: 90px;
    z-index: 10;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
}

.tt-avatar {
    width: 48px;
    height: 48px;

    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #1877f2;
    border: 2px solid #fff;

    font-size: 19px;
    font-weight: 800;
}

.tt-action {
    border: none;
    background: none;
    color: #fff;

    display: flex;
    flex-direction: column;
    align-items: center;

    font-size: 27px;

    cursor: pointer;
}

.tt-action small {
    margin-top: 3px;
    font-size: 11px;
    color: #fff;
}

/* BOTTOM NAV */

.tt-bottom {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;

    height: 65px;

    background: rgba(0,0,0,.95);

    display: flex;
    align-items: center;
    justify-content: space-around;

    z-index: 2000;
}

.tt-bottom a {
    width: 20%;

    color: #aaa;
    text-decoration: none;

    display: flex;
    flex-direction: column;
    align-items: center;

    font-size: 11px;
}

.tt-bottom a span {
    font-size: 23px;
    margin-bottom: 2px;
}

.tt-bottom a.active {
    color: #fff;
}

.tt-create {
    width: 48px !important;
    height: 38px;

    border-radius: 10px;

    background: #fff;
    color: #000 !important;

    display: flex !important;
    align-items: center;
    justify-content: center;

    font-size: 28px !important;
    font-weight: 700;
}

/* CREATE MODAL */

.modal {
    display: none;

    position: fixed;
    inset: 0;

    z-index: 5000;

    background: rgba(0,0,0,.75);

    align-items: center;
    justify-content: center;

    padding: 20px;
}

.modal-content {
    width: 100%;
    max-width: 430px;

    background: #fff;
    color: #111;

    border-radius: 20px;
    padding: 22px;

    position: relative;
}

.modal-content h2 {
    margin-bottom: 15px;
}

.modal-content textarea {
    width: 100%;
    padding: 12px;

    border: 1px solid #ddd;
    border-radius: 12px;

    resize: none;
}

.close-modal {
    position: absolute;
    top: 8px;
    right: 12px;

    border: none;
    background: none;

    font-size: 30px;
}

.photo-upload {
    display: block;

    margin: 12px 0;
    padding: 12px;

    background: #f1f1f1;
    border-radius: 10px;
}

.photo-upload input {
    display: block;
    margin-top: 8px;
}

.post-button {
    width: 100%;
    padding: 13px;

    border: none;
    border-radius: 10px;

    background: #1877f2;
    color: white;

    font-size: 16px;
    font-weight: bold;
}

/* MOBILE */

@media (max-width: 600px) {

    .tt-logo {
        font-size: 18px;
    }

    .tt-info {
        bottom: 82px;
    }

    .tt-actions {
        bottom: 82px;
    }

    .tt-text-post div {
        font-size: 25px;
    }
}

/* DESKTOP */

@media (min-width: 800px) {

    .tt-post {
        max-width: 500px;
        margin: auto;
    }

    .tt-feed {
        background: #000;
    }
}
